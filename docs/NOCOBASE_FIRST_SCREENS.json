{
  "version": "2026-07-15",
  "purpose": "First production-safe NocoBase admin screens for the SwimCRM hybrid rewrite.",
  "principles": [
    "Django remains the source of truth for business rules and transactional data.",
    "NocoBase uses token-protected Django bridge/config APIs for the first screens.",
    "NocoBase must not directly mutate payments, ledger, attendance, payroll calculations, receipts, or audit history."
  ],
  "auth": {
    "read_bridge": "NOCOBASE_BRIDGE_TOKEN",
    "config_write": "NOCOBASE_CONFIG_TOKEN"
  },
  "screens": [
    {
      "id": "operations_status",
      "title": "Operations Status",
      "phase": 1,
      "purpose": "Show backend readiness signals for notifications, receipt cleanup, Celery beat, and hybrid health.",
      "token": "NOCOBASE_BRIDGE_TOKEN",
      "mode": "read_only",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/ops-status/" }
      ],
      "primary_blocks": [
        "status badge: ok/warning/critical",
        "notification queue by status and channel",
        "failed notifications in last 24 hours",
        "oldest due notification age",
        "receipt cleanup backlog",
        "Celery beat expected-task status"
      ],
      "forbidden_actions": [
        "manual deletion of notification logs",
        "manual mutation of Celery schedule state",
        "marking failed sends as sent"
      ]
    },
    {
      "id": "client_directory",
      "title": "Client Directory",
      "phase": 1,
      "purpose": "Read-only admin visibility into participants, parent contacts, current balance, latest payment summary, and active subscription state.",
      "token": "NOCOBASE_BRIDGE_TOKEN",
      "mode": "read_only",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/clients/" }
      ],
      "filters": ["q", "active", "limit"],
      "primary_blocks": [
        "participant identity and group",
        "parent contact and preferred language",
        "balance and overdue flag",
        "latest payment summary without receipt data",
        "active subscription summary"
      ],
      "forbidden_actions": [
        "editing participant data directly",
        "viewing medical notes",
        "viewing receipt files",
        "changing remaining sessions",
        "confirming or rejecting payments"
      ]
    },
    {
      "id": "debtors",
      "title": "Debtors",
      "phase": 1,
      "purpose": "Read-only debt monitoring computed by Django billing services.",
      "token": "NOCOBASE_BRIDGE_TOKEN",
      "mode": "read_only",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/debtors/" }
      ],
      "primary_blocks": [
        "client and participant",
        "balance amount",
        "overdue status",
        "contact details"
      ],
      "forbidden_actions": [
        "manual balance edits",
        "manual ledger writes",
        "payment confirmation from NocoBase"
      ]
    },
    {
      "id": "quiet_hours",
      "title": "Quiet Hours",
      "phase": 1,
      "purpose": "Admin-editable notification quiet-hours windows through Django validation.",
      "token": "NOCOBASE_CONFIG_TOKEN",
      "mode": "guarded_config",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/config/quiet-hours/" },
        { "method": "POST", "path": "/api/nocobase/config/quiet-hours/" },
        { "method": "GET", "path": "/api/nocobase/config/quiet-hours/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/quiet-hours/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/quiet-hours/<id>/" }
      ],
      "fields": ["channel", "starts_at", "ends_at", "timezone", "is_active"],
      "forbidden_actions": [
        "direct edits to NotificationLog scheduling",
        "bypassing Django timezone validation"
      ]
    },
    {
      "id": "notification_templates_and_rules",
      "title": "Notification Templates and Rules",
      "phase": 1,
      "purpose": "Manage base notification templates and scheduling rules while keeping delivery execution and logs in Django.",
      "token": "NOCOBASE_CONFIG_TOKEN",
      "mode": "guarded_config",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/config/notification-templates/" },
        { "method": "POST", "path": "/api/nocobase/config/notification-templates/" },
        { "method": "GET", "path": "/api/nocobase/config/notification-templates/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/notification-templates/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/notification-templates/<id>/" },
        { "method": "GET", "path": "/api/nocobase/config/notification-rules/" },
        { "method": "POST", "path": "/api/nocobase/config/notification-rules/" },
        { "method": "GET", "path": "/api/nocobase/config/notification-rules/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/notification-rules/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/notification-rules/<id>/" }
      ],
      "fields": [
        "event_type",
        "channel",
        "subject",
        "body",
        "template_id",
        "offset_minutes",
        "is_active"
      ],
      "forbidden_actions": [
        "editing notification delivery logs",
        "retrying failed notifications",
        "marking notifications as sent",
        "editing provider message IDs or deduplication keys"
      ]
    },
    {
      "id": "locations_and_session_types",
      "title": "Locations and Session Types",
      "phase": 1,
      "purpose": "Manage operational location and supported session type dictionaries for admin UI, payroll setup, and future schedule dropdowns.",
      "token": "NOCOBASE_CONFIG_TOKEN",
      "mode": "guarded_config",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/config/locations/" },
        { "method": "POST", "path": "/api/nocobase/config/locations/" },
        { "method": "GET", "path": "/api/nocobase/config/locations/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/locations/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/locations/<id>/" },
        { "method": "GET", "path": "/api/nocobase/config/session-types/" },
        { "method": "POST", "path": "/api/nocobase/config/session-types/" },
        { "method": "GET", "path": "/api/nocobase/config/session-types/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/session-types/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/session-types/<id>/" }
      ],
      "fields": [
        "location code",
        "location name",
        "address",
        "timezone",
        "session type code",
        "session type label",
        "default_capacity",
        "is_active"
      ],
      "forbidden_actions": [
        "direct mutation of existing sessions",
        "direct mutation of attendance history",
        "adding unsupported session type codes",
        "editing payroll calculation results"
      ]
    },
    {
      "id": "payroll_rules",
      "title": "Payroll Rules",
      "phase": 1,
      "purpose": "Manage payroll schemes, rules, and trainer assignments while keeping calculation in Django.",
      "token": "NOCOBASE_CONFIG_TOKEN",
      "mode": "guarded_config",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/config/payroll/schemes/" },
        { "method": "POST", "path": "/api/nocobase/config/payroll/schemes/" },
        { "method": "GET", "path": "/api/nocobase/config/payroll/schemes/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/payroll/schemes/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/payroll/schemes/<id>/" },
        { "method": "GET", "path": "/api/nocobase/config/payroll/rules/" },
        { "method": "POST", "path": "/api/nocobase/config/payroll/rules/" },
        { "method": "GET", "path": "/api/nocobase/config/payroll/rules/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/payroll/rules/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/payroll/rules/<id>/" },
        { "method": "GET", "path": "/api/nocobase/config/payroll/assignments/" },
        { "method": "POST", "path": "/api/nocobase/config/payroll/assignments/" }
      ],
      "fields": [
        "scheme name and location",
        "session_type",
        "rule_type",
        "base_amount_minor",
        "min_clients_threshold",
        "extra_client_amount_minor",
        "trainer assignment dates"
      ],
      "forbidden_actions": [
        "editing payroll calculation results",
        "paying trainers from NocoBase",
        "overriding attendance history"
      ]
    },
    {
      "id": "payroll_periods_reporting",
      "title": "Payroll Periods Reporting",
      "phase": 1,
      "purpose": "Show read-only payroll period summaries and calculation lines generated by Django.",
      "token": "NOCOBASE_BRIDGE_TOKEN",
      "mode": "read_only",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/payroll/periods/" },
        { "method": "GET", "path": "/api/nocobase/payroll/periods/<id>/" }
      ],
      "filters": ["location", "status"],
      "primary_blocks": [
        "period date range and location",
        "period status",
        "totals by trainer",
        "calculation lines by session",
        "final amount per trainer/session"
      ],
      "forbidden_actions": [
        "creating or recalculating payroll periods from NocoBase",
        "approving or exporting payroll from NocoBase",
        "paying trainers from NocoBase",
        "editing attendance or calculation lines"
      ]
    },
    {
      "id": "localization",
      "title": "Localization",
      "phase": 1,
      "purpose": "Manage languages, dictionary keys, dictionary translations, and notification template translations.",
      "token": "NOCOBASE_CONFIG_TOKEN",
      "mode": "guarded_config",
      "endpoints": [
        { "method": "GET", "path": "/api/nocobase/config/languages/" },
        { "method": "POST", "path": "/api/nocobase/config/languages/" },
        { "method": "GET", "path": "/api/nocobase/config/languages/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/languages/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/languages/<id>/" },
        { "method": "GET", "path": "/api/nocobase/config/dictionary-keys/" },
        { "method": "POST", "path": "/api/nocobase/config/dictionary-keys/" },
        { "method": "GET", "path": "/api/nocobase/config/dictionary-keys/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/dictionary-keys/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/dictionary-keys/<id>/" },
        { "method": "GET", "path": "/api/nocobase/config/dictionary-translations/" },
        { "method": "POST", "path": "/api/nocobase/config/dictionary-translations/" },
        { "method": "GET", "path": "/api/nocobase/config/dictionary-translations/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/dictionary-translations/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/dictionary-translations/<id>/" },
        { "method": "GET", "path": "/api/nocobase/config/notification-template-translations/" },
        { "method": "POST", "path": "/api/nocobase/config/notification-template-translations/" },
        { "method": "GET", "path": "/api/nocobase/config/notification-template-translations/<id>/" },
        { "method": "POST/PATCH/PUT", "path": "/api/nocobase/config/notification-template-translations/<id>/" },
        { "method": "DELETE", "path": "/api/nocobase/config/notification-template-translations/<id>/" }
      ],
      "fields": [
        "language code and name",
        "dictionary domain and code",
        "translation value",
        "notification template translation subject/body"
      ],
      "forbidden_actions": [
        "editing notification delivery logs",
        "editing base notification rules until a guarded endpoint exists"
      ]
    }
  ],
  "deferred_candidates": []
}
